{
  "name": "Minecraft API",
  "slug": "minecraft-api",
  "shortName": "MAPI",
  "modId": "mapi",
  "language": "java",
  "version": "0.1.0",
  "minecraftTarget": "26.2",
  "loaders": ["fabric", "neoforge"],
  "packageGroup": "dev.example.mapi",
  "modules": [
    {
      "path": "common",
      "kind": "shared-library",
      "description": "Loader-neutral public API (dev.example.mapi.api), internal runtime, local HTTP server, unit and HTTP contract tests."
    },
    {
      "path": "fabric",
      "kind": "loader-adapter",
      "description": "Fabric entrypoint, platform adapter, fabric.mod.json, dev runs.",
      "runTasks": [":fabric:runClient", ":fabric:runServer"]
    },
    {
      "path": "neoforge",
      "kind": "loader-adapter",
      "description": "NeoForge entrypoint, platform adapter, mods.toml template, dev runs.",
      "runTasks": [":neoforge:runClient", ":neoforge:runServer"]
    },
    {
      "path": "example-consumer",
      "kind": "example",
      "description": "Compiles against the public API only; never included in distributable jars."
    }
  ],
  "documentation": {
    "entrypoint": "AGENTS.md",
    "index": "docs/README.md",
    "files": [
      { "path": "docs/toolchain.md", "topic": "verified versions and sources" },
      { "path": "docs/architecture.md", "topic": "modules and boundaries" },
      { "path": "docs/development.md", "topic": "build, run, test commands" },
      { "path": "docs/api.md", "topic": "public Java API contract" },
      { "path": "docs/http-api.md", "topic": "local HTTP endpoints and schemas" },
      { "path": "docs/security.md", "topic": "HTTP security model" },
      { "path": "docs/llm-workflow.md", "topic": "coding-agent workflow" },
      { "path": "docs/troubleshooting.md", "topic": "known failure modes" },
      { "path": "docs/roadmap.md", "topic": "target architecture review, reconciliation, and delivery plan" },
      { "path": "docs/openapi.yaml", "topic": "OpenAPI description of the HTTP API" },
      { "path": "README.md", "topic": "human-facing overview and quick start" },
      { "path": "CONTRIBUTING.md", "topic": "contribution rules" }
    ]
  },
  "commands": {
    "gradle": {
      "diagnose": "doctor",
      "build": "buildAll",
      "test": "testAll",
      "verify": "verify",
      "formatCheck": "formatCheck",
      "formatApply": "formatApply",
      "apiDocs": "apiDocs",
      "publishLocal": "publishLocal",
      "llmContext": "llmContext",
      "validateManifest": "validateManifest"
    },
    "scripts": {
      "doctor": "scripts/doctor.sh",
      "serverSmoke": "scripts/server-smoke.sh",
      "verifyPublishedApi": "scripts/verify-published-api.sh",
      "httpClientExample": "scripts/mapi-client.py"
    }
  },
  "artifacts": {
    "fabric": "fabric/build/libs/minecraft-api-fabric-<version>.jar",
    "neoforge": "neoforge/build/libs/minecraft-api-neoforge-<version>.jar",
    "common": "common/build/libs/minecraft-api-common-<version>.jar",
    "apiJavadoc": "common/build/docs/javadoc/index.html",
    "llmContext": "build/llm/CONTEXT.md"
  },
  "secrets": {
    "neverCommit": ["MAPI_HTTP_TOKEN", "http.token", "eula.txt", "run directories"]
  }
}