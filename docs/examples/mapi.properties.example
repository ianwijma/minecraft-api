# Example MAPI configuration. Copy to <gameDir>/config/mapi.properties and edit.
# NEVER put a real token into version control. Environment variables override
# this file; MAPI_HTTP_TOKEN is the preferred way to supply the token.

# Enable the local HTTP API (default: false)
http.enabled=true

# Loopback port (default: 25586)
http.port=25586

# Bearer token, at least 16 characters. Prefer the MAPI_HTTP_TOKEN env var;
# this file is for convenience on private machines only. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
http.token=REPLACE-WITH-LONG-RANDOM-TOKEN

# Requests per client per minute (default: 60)
http.rateLimitPerMinute=60